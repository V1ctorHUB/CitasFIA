# Copia este archivo a .env y reemplaza TODOS los valores. Nunca subas .env al repositorio.
# Genera cada secreto con: openssl rand -base64 32

# --- PostgreSQL ---
POSTGRES_DB=citas
POSTGRES_PASSWORD=cambia-esto-superusuario
OWNER_DB_PASSWORD=cambia-esto-migraciones
APP_DB_PASSWORD=cambia-esto-aplicacion

# --- Aplicación ---
# Origen público exacto con el que los estudiantes abren el formulario (protección CSRF).
APP_ORIGIN=https://citas.ejemplo.uca.edu.sv

# Claves del DUI (32 bytes en base64). Si se pierden, los DUI cifrados son irrecuperables:
# guárdalas también fuera de la laptop (ver docs/DESPLIEGUE_SERVIDOR_LOCAL.md).
DUI_ENCRYPTION_KEY=
DUI_HASH_KEY=

# --- Acceso de coordinación (/admin) ---
# Genera ADMIN_CLAVE_HASH y SESSION_SECRET con: npm run admin:clave
ADMIN_USUARIO=oarias
ADMIN_NOMBRE=Oscar Arias
ADMIN_CLAVE_HASH=
SESSION_SECRET=

# --- Correos a estudiantes (Zoho Mail) ---
# Solo la cuenta y su clave. Con verificación en dos pasos usa una contraseña de aplicación:
# accounts.zoho.com → Seguridad → Contraseñas de aplicación. Vacío: los correos quedan pendientes.
ZOHO_CORREO=
ZOHO_CLAVE=
# Solo si la cuenta está en otro centro de datos (p. ej. smtp.zoho.eu); por defecto smtp.zoho.com.
# ZOHO_SMTP_HOST=
# Desarrollo: EMAIL_TRANSPORT=consola imprime los correos en el log en lugar de enviarlos.

# --- Respaldos (scripts/backup.sh) ---
BACKUP_DIR=/srv/citas/backups
# Disco externo o carpeta de red para la segunda copia; vacío para desactivar.
BACKUP_MIRROR_DIR=
BACKUP_RETENTION_DAYS=30

# --- Desarrollo local sin Docker ---
# DATABASE_URL=postgres://citas_app:<APP_DB_PASSWORD>@localhost:5433/citas
# DATABASE_ADMIN_URL=postgres://citas_owner:<OWNER_DB_PASSWORD>@localhost:5433/citas
# TEST_DATABASE_URL=postgres://postgres:<POSTGRES_PASSWORD>@localhost:5433/citas_test
